# --- API keys (all free tiers) -----------------------------------------
# Google AI Studio key for Gemini summaries: https://aistudio.google.com/
GEMINI_API_KEY=
# Gemini model ID (change if Google retires it from the free tier)
GEMINI_MODEL=gemini-flash-latest
# Lighter model tried when the main one is overloaded (leave empty to disable)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Request budget kept below your free-tier limits (check AI Studio)
GEMINI_RPM=10
GEMINI_RPD=200
# Finnhub key for company news, earnings dates and Discover: https://finnhub.io/
FINNHUB_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact email
# e.g. SEC_USER_AGENT=Kairos you@example.com
SEC_USER_AGENT=

# --- Optional sources --------------------------------------------------
# Reddit public RSS (off by default; Reddit API access is restricted)
REDDIT_ENABLED=false

# --- Behaviour ---------------------------------------------------------
# Your timezone (IANA name, e.g. Asia/Manila, America/New_York)
TZ=UTC
# Daily automatic refresh of holdings + watchlist (HH:MM in TZ)
MORNING_REFRESH_TIME=07:00
# Second refresh before the US open: readings only, no Discover scan (empty disables)
EVENING_REFRESH_TIME=21:00
# How long a reading is reused before it is rebuilt
READING_CACHE_HOURS=4
# Days of news to read per ticker
NEWS_WINDOW_DAYS=7
# Comma-separated tickers to seed your lists on first start (optional)
KAIROS_SEED_HOLDINGS=
KAIROS_SEED_WATCHING=

# --- Hype warning thresholds -------------------------------------------
MICRO_CAP_USD=300000000
PRICE_SPIKE_PCT=30
PENNY_PRICE=5
LOW_VOLUME=100000
ATTENTION_RATIO=3
ATTENTION_MIN_ARTICLES=5

# --- Storage -----------------------------------------------------------
DB_PATH=data/kairos.db
